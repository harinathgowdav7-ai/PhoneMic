<Application x:Class="PhoneMic.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Exact 1:1 PhoneMic Reference Palette & Card Styles -->
        <SolidColorBrush x:Key="PrimaryGreenBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="DarkGreenBrush" Color="#15803D" />
        <SolidColorBrush x:Key="BrightGreenBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="SoftGreenBgBrush" Color="#DCFCE7" />
        <SolidColorBrush x:Key="LightGreenTintBrush" Color="#E8F8EE" />
        <SolidColorBrush x:Key="DisconnectRedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="SoftRedBgBrush" Color="#FEF2F2" />
        <SolidColorBrush x:Key="SoftRedBorderBrush" Color="#FCA5A5" />
        <SolidColorBrush x:Key="AppBgBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#F4F8F6" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.05" Color="#0F172A" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
